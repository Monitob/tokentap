# ─────────────────────────────────────────────────────────────────────────
# TokenTap — example environment configuration
#
# Copy this file to `.env` and edit the values.  The `.env` file is
# git-ignored and will NEVER be committed.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────

# Port TokenTap listens on (clients connect here).
PORT=3459

# Host/interface to bind.  Use 0.0.0.0 to expose on all interfaces
# (only do this behind a firewall / VPN).
HOST=127.0.0.1

# Upstream gateway or API that TokenTap forwards requests to.
TARGET_HOST=127.0.0.1
TARGET_PORT=3456

# Default max_tokens cap applied when no per-model rule matches.
MAX_TOKENS_CAP=16384

# Per-model caps, comma-separated.  Model names are matched
# case-insensitively as substrings of the request's `model` field,
# so "glm" matches "glm-5.2", "glm-4-flash", etc.
#
# Examples:
#   MODEL_CAPS=glm-5.2:16384
#   MODEL_CAPS=glm:16384,qwen3:32768,llama3:8192
MODEL_CAPS=

# Log verbosity: none | error | info | debug
LOG_LEVEL=info

# Path for the health-check endpoint.
HEALTH_PATH=/health
